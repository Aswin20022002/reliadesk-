# All optional. With no key the desk still works end to end using the rule-based agents.
# Add ANY of these free keys (no card needed) to switch on the tool-calling LLM agent and plain-English briefings.
# Providers are tried in the order of LLM_CHAIN; a rate limit or failure falls through to the next one.
LLM_CHAIN=groq,gemini,openrouter,xai

# Groq: free tier, fast open models. Key at console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google AI Studio (Gemini): free tier. Key at aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# OpenRouter: free model variants. Key at openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# xAI Grok: promotional credits only, not a permanent free tier. Key at console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4.3

# Protects free quotas on a public URL (per server instance)
AGENT_DAILY_CAP=400
